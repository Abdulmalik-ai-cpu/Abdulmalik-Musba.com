# Root environment — used by Prisma CLI (migrations, seed, studio).
# Copy to .env and adjust for your local setup.

DATABASE_URL="postgresql://portfolio:portfolio_dev_password@localhost:5432/portfolio_dev"

# Super admin bootstrap credentials (used by `pnpm db:seed`).
# If unset, the seed generates a strong random password and prints it once.
# Set these explicitly in production and keep ADMIN_PASSWORD out of version control.
ADMIN_EMAIL="admin@abdulmalik-musba.com"
# ADMIN_PASSWORD="change-me-to-a-strong-password"