# Root environment — used by Prisma CLI (migrations, seed, studio).
# Copy to .env and adjust for your local setup.

DATABASE_URL="postgresql://portfolio:portfolio_dev_password@localhost:5432/portfolio_dev"

# Super admin bootstrap credentials (used by `pnpm db:seed`).
# If unset, the seed generates a strong random password and prints it once.
# Set these explicitly in production and keep ADMIN_PASSWORD out of version control.
ADMIN_EMAIL="admin@abdulmalik-musba.com"
# ADMIN_PASSWORD="change-me-to-a-strong-password"
# ---------------------------------------------------------------------------
# Optional local infrastructure (see docker-compose.yml, §140.40–42).
# The defaults below match `docker compose up -d`.
# ---------------------------------------------------------------------------

# Redis is reserved for background jobs and caching (§140.20, §140.24).
REDIS_URL="redis://localhost:6379"

# Local S3-compatible storage (MinIO). Leave unset to use the local-disk
# adapter in apps/api/src/storage (§140.41, §143.20).
# STORAGE_ENDPOINT="http://localhost:9000"
# STORAGE_REGION="us-east-1"
# STORAGE_BUCKET="portfolio-public"
# STORAGE_ACCESS_KEY="minio_dev_access"
# STORAGE_SECRET_KEY="minio_dev_secret"
# STORAGE_PUBLIC_BASE_URL="http://localhost:9000/portfolio-public"

# Local email capture (Mailpit). Never point development at real recipients
# (§140.42, §143.26). Use EMAIL_PROVIDER=resend in production.
EMAIL_PROVIDER="console"
# EMAIL_PROVIDER="smtp"
# SMTP_HOST="localhost"
# SMTP_PORT="1025"
# SMTP_SECURE="false"
CONTACT_FROM_EMAIL="no-reply@abdulmalik-musba.com"
CONTACT_TO_EMAIL="admin@abdulmalik-musba.com"

# Opaque session-token signing secret. Generate a long random value in
# production and keep it out of version control (§140.50).
JWT_SECRET="development-only-secret-change-me"
