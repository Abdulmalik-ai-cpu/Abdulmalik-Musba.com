// General Personal Portfolio Website — canonical data model.
// The database is the single source of truth for all portfolio content.
// Super Admin Portal writes through the NestJS API. Public Web reads through the API.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & Profile
// ---------------------------------------------------------------------------

model Profile {
  id                String   @id @default(cuid())
  fullName          String
  displayName       String
  professionalTitle String
  shortIntro        String
  biography         String
  longBiography     String?
  profileImageUrl   String?
  location          String?
  nationality       String?
  languages         String[]
  email             String?
  phone             String?
  orcid             String?
  googleScholar     String?
  github            String?
  linkedin          String?
  personalDomains   String[]
  externalWebsites  String[]
  cvUrl             String?
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())

  education   Education[]
  experience  Experience[]
  research    Research[]
  projects    Project[]
  publications Publication[]
  articles    Article[]
  skills      Skill[]
  certifications Certification[]
  achievements Achievement[]
  awards      Award[]
  talks       Talk[]
  services    Service[]
  contactInfo ContactInfo[]
  socialLinks SocialLink[]
  timelineRecords TimelineRecord[]
}

// ---------------------------------------------------------------------------
// Time-aware entities (long-life architecture)
// ---------------------------------------------------------------------------

enum Visibility {
  PUBLIC
  PRIVATE
  ARCHIVED
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

model Education {
  id            String   @id @default(cuid())
  institution   String
  degree        String
  fieldOfStudy  String?
  startDate     DateTime
  endDate       DateTime?
  current       Boolean  @default(false)
  description   String?
  visibility    Visibility @default(PUBLIC)
  profile       Profile? @relation(fields: [profileId], references: [id])
  profileId     String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Experience {
  id          String   @id @default(cuid())
  title       String
  company     String?
  organization String?
  location    String?
  startDate   DateTime
  endDate     DateTime?
  current     Boolean  @default(false)
  description String?
  achievements String?
  visibility  Visibility @default(PUBLIC)
  profile     Profile? @relation(fields: [profileId], references: [id])
  profileId   String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Research {
  id          String   @id @default(cuid())
  title       String
  category    String?
  summary     String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  current     Boolean  @default(false)
  status      String?
  url         String?
  visibility  Visibility @default(PUBLIC)
  profile     Profile? @relation(fields: [profileId], references: [id])
  profileId   String?
  sortOrder   Int      @default(0)
  projects    Project[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  title       String
  summary     String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  current     Boolean  @default(false)
  status      String?
  repositoryUrl String?
  liveUrl     String?
  imageUrl    String?
  sortOrder   Int      @default(0)
  visibility  Visibility @default(PUBLIC)
  featured    Boolean  @default(false)
  profile     Profile? @relation(fields: [profileId], references: [id])
  profileId   String?
  research    Research? @relation(fields: [researchId], references: [id])
  researchId  String?
  technologies Technology[]
  publications Publication[]
  media       Media[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Technology {
  id        String    @id @default(cuid())
  name      String
  category  String?
  icon      String?
  proficiency Int?     @default(0)
  sortOrder     Int       @default(0)
  visibility Visibility @default(PUBLIC)
  skills    Skill[]
  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Skill {
  id          String   @id @default(cuid())
  name        String
  category    String?
  level       String?
  proficiency Int?     @default(0)
  sortOrder   Int      @default(0)
  visibility  Visibility @default(PUBLIC)
  profile     Profile? @relation(fields: [profileId], references: [id])
  profileId   String?
  technologies Technology[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Certification {
  id           String   @id @default(cuid())
  title        String
  issuer       String
  dateObtained DateTime?
  expirationDate DateTime?
  credentialUrl String?
  credentialId String?
  sortOrder        Int      @default(0)
  visibility   Visibility @default(PUBLIC)
  profile      Profile? @relation(fields: [profileId], references: [id])
  profileId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Achievement {
  id          String   @id @default(cuid())
  title       String
  description String?
  date        DateTime?
  category    String?
  sortOrder   Int      @default(0)
  visibility  Visibility @default(PUBLIC)
  profile     Profile? @relation(fields: [profileId], references: [id])
  profileId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Award {
  id          String   @id @default(cuid())
  title       String
  issuer      String?
  description String?
  date        DateTime?
  sortOrder   Int      @default(0)
  visibility  Visibility @default(PUBLIC)
  profile     Profile? @relation(fields: [profileId], references: [id])
  profileId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Talk {
  id          String   @id @default(cuid())
  title       String
  event       String?
  date        DateTime?
  location    String?
  url         String?
  description String?
  sortOrder   Int      @default(0)
  visibility  Visibility @default(PUBLIC)
  profile     Profile? @relation(fields: [profileId], references: [id])
  profileId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Service {
  id          String   @id @default(cuid())
  title       String
  description String?
  sortOrder   Int      @default(0)
  visibility  Visibility @default(PUBLIC)
  profile     Profile? @relation(fields: [profileId], references: [id])
  profileId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TimelineRecord {
  id          String    @id @default(cuid())
  title       String
  description String?
  date        DateTime
  category    String?
  sortOrder       Int       @default(0)
  visibility  Visibility @default(PUBLIC)
  profile     Profile?  @relation(fields: [profileId], references: [id])
  profileId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Publications & Articles
// ---------------------------------------------------------------------------

enum PublicationType {
  JOURNAL
  CONFERENCE
  THESIS
  REPORT
  BOOK
  CHAPTER
  OTHER
}

model Publication {
  id          String          @id @default(cuid())
  title       String
  type        PublicationType @default(OTHER)
  authors     String[]
  venue       String?
  year        Int?
  doi         String?
  url         String?
  citation    String?
  summary     String?
  publishedAt DateTime?
  sortOrder       Int             @default(0)
  visibility  Visibility      @default(PUBLIC)
  profile     Profile?        @relation(fields: [profileId], references: [id])
  profileId   String?
  projects    Project[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Article {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  excerpt     String?
  content     String
  status      PublishStatus @default(DRAFT)
  publishedAt DateTime?
  scheduledFor DateTime?
  timezone    String?
  seoTitle    String?
  seoDescription String?
  tags        String[]
  coverImageUrl String?
  readingTime Int?
  sortOrder       Int           @default(0)
  visibility  Visibility    @default(PUBLIC)
  featured    Boolean       @default(false)
  profile     Profile?      @relation(fields: [profileId], references: [id])
  profileId   String?
  revisions   Revision[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Revision {
  id        String   @id @default(cuid())
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId String
  version   Int
  content   String
  title     String
  changelog String?
  createdAt DateTime @default(now())

  @@unique([articleId, version])
}

// ---------------------------------------------------------------------------
// Media & Documents
// ---------------------------------------------------------------------------

enum MediaType {
  IMAGE
  DOCUMENT
  VIDEO
  AUDIO
  OTHER
}

enum StorageClass {
  PUBLIC
  PRIVATE
  ADMIN_ONLY
}

model Media {
  id          String      @id @default(cuid())
  filename    String
  originalName String
  mimeType    String
  size        Int
  url         String?
  altText     String?
  caption     String?
  type        MediaType   @default(IMAGE)
  storageClass StorageClass @default(PUBLIC)
  width       Int?
  height      Int?
  project     Project?    @relation(fields: [projectId], references: [id])
  projectId   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// ---------------------------------------------------------------------------
// Contact
// ---------------------------------------------------------------------------

model ContactInfo {
  id        String   @id @default(cuid())
  label     String
  value     String
  type      String   @default("EMAIL") // EMAIL, PHONE, ADDRESS, URL
  sortOrder     Int      @default(0)
  visibility Visibility @default(PUBLIC)
  profile   Profile? @relation(fields: [profileId], references: [id])
  profileId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ContactStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

model ContactSubmission {
  id        String        @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  status    ContactStatus @default(NEW)
  ip        String?
  userAgent String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  readAt    DateTime?
}

model SocialLink {
  id         String   @id @default(cuid())
  platform   String
  label      String
  url        String
  icon       String?
  visibility Visibility @default(PUBLIC)
  sortOrder      Int      @default(0)
  profile    Profile? @relation(fields: [profileId], references: [id])
  profileId  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Navigation, SEO, Settings
// ---------------------------------------------------------------------------

model NavItem {
  id        String @id @default(cuid())
  label     String
  href      String
  order     Int    @default(0)
  visible   Boolean @default(true)
  isExternal Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SeoConfig {
  id          String  @id @default("default")
  siteTitle   String
  description String
  keywords    String[]
  ogImageUrl  String?
  twitterHandle String?
  canonicalBaseUrl String?
  robotsTxt   String?
  updatedAt   DateTime @updatedAt
}

model SiteSetting {
  id        String  @id @default("default")
  siteName  String
  tagline   String?
  footerText String?
  theme     String  @default("dark")
  contactEnabled Boolean @default(true)
  analyticsEnabled Boolean @default(false)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model SettingKV {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Auth, Audit, and System
// ---------------------------------------------------------------------------

model AdminUser {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  passwordHash  String?
  role          String   @default("SUPER_ADMIN")
  isActive      Boolean  @default(true)
  lastLoginAt   DateTime?
  mfaEnabled    Boolean  @default(false)
  failedLoginAttempts Int @default(0)
  lockedUntil   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions AuthSession[]
  auditLogs AuditLog[]
}

model AuthSession {
  id         String    @id @default(cuid())
  adminUser  AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  adminUserId String
  token      String    @unique
  ip         String?
  userAgent  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([adminUserId])
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  PUBLISH
  UNPUBLISH
  LOGIN
  LOGOUT
  FAILED_LOGIN
  UPLOAD
  DOWNLOAD
  EXPORT
  SETTINGS_UPDATE
  OTHER
}

model AuditLog {
  id         String      @id @default(cuid())
  adminUser  AdminUser?  @relation(fields: [adminUserId], references: [id])
  adminUserId String?
  action     AuditAction
  entity     String?
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime    @default(now())

  @@index([adminUserId])
  @@index([entity, entityId])
  @@index([createdAt])
}

model BackupRecord {
  id          String   @id @default(cuid())
  filename    String
  size        Int?
  status      String   @default("PENDING")
  startedAt   DateTime @default(now())
  completedAt DateTime?
  location    String?
  createdAt   DateTime @default(now())
}

model IntegrationState {
  id          String   @id @default(cuid())
  provider    String   @unique
  enabled     Boolean  @default(false)
  config      Json?
  lastSyncAt  DateTime?
  status      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}