# HTTP
PORT=3001
NODE_ENV=development

# CORS
# PUBLIC_ORIGIN=http://localhost:3000
# ADMIN_ORIGIN=http://localhost:3002
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Database
DATABASE_URL="postgresql://portfolio:portfolio_dev_password@localhost:5432/portfolio_dev"

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
SESSION_TTL_DAYS=7

# Redis (optional in development)
REDIS_URL=

# Object storage (Cloudflare R2 / S3-compatible — optional in development)
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Email (Resend)
EMAIL_PROVIDER=console
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Analytics
ANALYTICS_PROVIDER=none
PLAUSIBLE_DOMAIN=

# Observability
SENTRY_DSN=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300